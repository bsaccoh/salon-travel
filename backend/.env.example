# ──────────────────────────────────────────────
# Salone Travel Concierge — Environment Config
# Copy to .env and fill in real values
# ──────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Expand libuv thread pool so argon2 hashing doesn't starve I/O under load
UV_THREADPOOL_SIZE=16

# Database (PostgreSQL 15 + PostGIS)
# Add ?connection_limit=10&pool_timeout=30 to cap Prisma's connection pool
DATABASE_URL=postgresql://salone:salone_dev_password@localhost:5432/salone_travel?schema=public

# Redis 7
REDIS_URL=redis://localhost:6379

# JWT
JWT_SIGNING_KEY=CHANGE_ME_generate_a_secure_random_key_at_least_32_characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=30d

# Storage (S3-compatible — optional in Phase 1)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# Stripe
# STRIPE_SECRET_KEY=sk_test_xxxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxx

# SendGrid Email
# SENDGRID_API_KEY=SG.xxxx
# SENDGRID_FROM_EMAIL=noreply@salonetravel.com

# Twilio SMS & WhatsApp
# TWILIO_ACCOUNT_SID=ACxxxx
# TWILIO_AUTH_TOKEN=xxxx
# TWILIO_FROM_NUMBER=+1234567890
# TWILIO_SMS_FROM=+1234567890
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Emergency On-Call
# EMERGENCY_ON_CALL_PHONE=+23276000999
# EMERGENCY_ON_CALL_WHATSAPP=+23276000999

# Google Maps (optional)
# GOOGLE_MAPS_API_KEY=

# Sentry (optional)
# SENTRY_DSN=


# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
